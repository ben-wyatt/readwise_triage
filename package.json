  "main": "index.js",
  "scripts": {
    "start": "tsx src/index.ts",
    "test": "node --import tsx --test src/**/*.test.ts",
    "typecheck": "tsc --noEmit",
    "verify": "npm test && npm run typecheck && npm run worker:typecheck",
    "worker:types": "wrangler types worker/worker-configuration.d.ts -c worker/wrangler.jsonc",
    "worker:typecheck": "tsc --noEmit -p worker/tsconfig.json",
    "worker:deploy": "wrangler deploy -c worker/wrangler.jsonc"
  },
